{
  "experiment_name": "clothing_validation_v2_binary_l00",
  "use_wandb": false,
  "best_metric": "validation/ndcg@20",
  "dataset": {
    "type": "graph",
    "use_train_data_only": true,
    "use_user_graph": true,
    "use_item_graph": true,
    "neighborhood_size": 50,
    "graph_dir_path": "./data/Clothing_v2",
    "dataset": {
      "type": "mclsr",
      "path_to_data_dir": "./data",
      "name": "Clothing_v2",
      "expected_protocol": "windowed-v2",
      "max_sequence_length": 20,
      "samplers": {
        "num_negatives_train": 0,
        "type": "mclsr"
      },
      "max_history_length": 20
    },
    "interaction_weighting": "binary"
  },
  "dataloader": {
    "train": {
      "type": "torch",
      "batch_size": 128,
      "batch_processor": {
        "type": "basic"
      },
      "drop_last": true,
      "shuffle": true,
      "pin_memory": true
    },
    "validation": {
      "type": "torch",
      "batch_size": 128,
      "batch_processor": {
        "type": "basic"
      },
      "drop_last": false,
      "shuffle": false,
      "pin_memory": true
    }
  },
  "model": {
    "type": "mclsr",
    "sequence_prefix": "item",
    "user_prefix": "user",
    "labels_prefix": "labels",
    "eval_top_k": 1000,
    "embedding_dim": 64,
    "num_graph_layers": 2,
    "dropout": 0.3,
    "layer_norm_eps": 1e-9,
    "graph_dropout": 0.3,
    "initializer_range": 0.02,
    "alpha": 0.5,
    "use_graph": true,
    "share_il_projector": true,
    "use_layernorm": true,
    "graph_layer_mean": false
  },
  "optimizer": {
    "type": "basic",
    "optimizer": {
      "type": "adam",
      "lr": 0.001
    }
  },
  "loss": {
    "type": "composite",
    "losses": [
      {
        "type": "mclsr_logq_inbatch",
        "queries_prefix": "combined_representation",
        "positive_prefix": "label_representation",
        "positive_ids_prefix": "positive_ids",
        "user_ids_prefix": "user_ids",
        "path_to_item_counts": "./data/Clothing_v2/item_target_counts.pkl",
        "logq_lambda": 0,
        "output_prefix": "downstream_loss",
        "weight": 1,
        "expected_counts_role": "target",
        "expected_counts_max_len": 21,
        "variant": "negatives_only",
        "temperature": 1,
        "normalize_embeddings": false,
        "leave_own_out": false,
        "correct_positive": false,
        "mixed_uniform_negatives": 0
      },
      {
        "type": "fps",
        "fst_embeddings_prefix": "sequential_representation",
        "snd_embeddings_prefix": "graph_representation",
        "output_prefix": "contrastive_interest_loss",
        "weight": 1,
        "temperature": 0.5,
        "scheme": "paper",
        "normalize_embeddings": true
      },
      {
        "type": "fps",
        "fst_embeddings_prefix": "common_graph_user_embeddings",
        "snd_embeddings_prefix": "user_graph_user_embeddings",
        "output_prefix": "contrastive_user_feature_loss",
        "weight": 0.05,
        "temperature": 0.5,
        "scheme": "paper",
        "normalize_embeddings": true
      },
      {
        "type": "fps",
        "fst_embeddings_prefix": "common_graph_item_embeddings",
        "snd_embeddings_prefix": "item_graph_item_embeddings",
        "output_prefix": "contrastive_item_feature_loss",
        "weight": 0.05,
        "temperature": 0.5,
        "scheme": "paper",
        "normalize_embeddings": true
      }
    ],
    "output_prefix": "loss"
  },
  "callback": {
    "type": "composite",
    "callbacks": [
      {
        "type": "metric",
        "on_step": 1,
        "loss_prefix": "loss"
      },
      {
        "type": "metric",
        "on_step": 1,
        "loss_prefix": "downstream_loss"
      },
      {
        "type": "metric",
        "on_step": 1,
        "loss_prefix": "contrastive_interest_loss"
      },
      {
        "type": "metric",
        "on_step": 1,
        "loss_prefix": "contrastive_user_feature_loss"
      },
      {
        "type": "metric",
        "on_step": 1,
        "loss_prefix": "contrastive_item_feature_loss"
      },
      {
        "type": "validation",
        "on_step": 256,
        "pred_prefix": "predictions",
        "labels_prefix": "labels",
        "metrics": {
          "ndcg@20": {
            "type": "mclsr-ndcg",
            "k": 20
          },
          "recall@1000": {
            "type": "mclsr-recall",
            "k": 1000
          }
        }
      }
    ]
  },
  "train_steps_num": 65536,
  "epochs_threshold": 65536,
  "seed": 1
}
